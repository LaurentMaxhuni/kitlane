# Server only. Neon injects database/auth URLs in deployed Functions.
DATABASE_URL=
NEON_AUTH_BASE_URL=https://ep-broad-credit-bakfgny4.neonauth.c-8.eu-central-1.aws.neon.tech/kitlane/auth
NEON_AUTH_JWKS_URL=https://ep-broad-credit-bakfgny4.neonauth.c-8.eu-central-1.aws.neon.tech/kitlane/auth/.well-known/jwks.json
# Set exact trusted HTTPS origin of the deployed bridge/API.
KITLANE_ORIGIN=
KITLANE_AUTH_ISSUER=https://ep-broad-credit-bakfgny4.neonauth.c-8.eu-central-1.aws.neon.tech
# Use the audience issued by this branch's /token endpoint; never accept arbitrary audiences.
KITLANE_AUTH_AUDIENCE=https://ep-broad-credit-bakfgny4.neonauth.c-8.eu-central-1.aws.neon.tech
