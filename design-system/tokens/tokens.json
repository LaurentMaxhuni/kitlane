{
  "color": {
    "$type": "color",
    "ink": { "$value": "#081B31" },
    "navy": { "$value": "#091C31" },
    "cyan": { "$value": "#01BCFB" },
    "mint": { "$value": "#19F5BE" },
    "white": { "$value": "#FFFFFF" },
    "pale": { "$value": "#F4F7FA" },
    "slate": { "$value": "#607286" },
    "line": { "$value": "#DCE5EC" },
    "darkSurface": { "$value": "#102A43" },
    "darkRaised": { "$value": "#17354F" },
    "darkMuted": { "$value": "#A8B7C6" },
    "darkLine": { "$value": "#36536B" },
    "focus": { "$value": "#0079AA" },
    "infoText": { "$value": "#00628A" },
    "infoBg": { "$value": "#E5F7FF" },
    "successText": { "$value": "#087B5C" },
    "successBg": { "$value": "#E0FBF1" },
    "warningText": { "$value": "#925B00" },
    "warningBg": { "$value": "#FFF5DD" },
    "dangerText": { "$value": "#B4232B" },
    "dangerBg": { "$value": "#FFF0F1" }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["Sora", "Avenir Next", "sans-serif"] },
    "ui": { "$value": ["Inter", "Segoe UI", "sans-serif"] },
    "mono": { "$value": ["ui-monospace", "Cascadia Code", "SFMono-Regular", "Consolas", "monospace"] }
  },
  "weight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 }, "medium": { "$value": 500 },
    "semibold": { "$value": 600 }, "bold": { "$value": 700 }, "brand": { "$value": 800 }
  },
  "fontSize": {
    "$type": "dimension",
    "caption": { "$value": { "value": 12, "unit": "px" } },
    "small": { "$value": { "value": 14, "unit": "px" } },
    "body": { "$value": { "value": 16, "unit": "px" } },
    "lead": { "$value": { "value": 18, "unit": "px" } },
    "heading": { "$value": { "value": 24, "unit": "px" } },
    "title": { "$value": { "value": 32, "unit": "px" } },
    "display": { "$value": { "value": 48, "unit": "px" } }
  },
  "lineHeight": {
    "$type": "number", "tight": { "$value": 1.15 }, "heading": { "$value": 1.3 }, "body": { "$value": 1.5 }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } }, "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } }, "4": { "$value": { "value": 16, "unit": "px" } },
    "5": { "$value": { "value": 20, "unit": "px" } }, "6": { "$value": { "value": 24, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } }, "10": { "$value": { "value": 40, "unit": "px" } },
    "12": { "$value": { "value": 48, "unit": "px" } }, "16": { "$value": { "value": 64, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension", "control": { "$value": { "value": 8, "unit": "px" } },
    "group": { "$value": { "value": 12, "unit": "px" } }, "panel": { "$value": { "value": 16, "unit": "px" } },
    "pill": { "$value": { "value": 999, "unit": "px" } }
  },
  "size": {
    "$type": "dimension",
    "control": { "$value": { "value": 42, "unit": "px" } },
    "controlCompact": { "$value": { "value": 34, "unit": "px" } },
    "controlLarge": { "$value": { "value": 48, "unit": "px" } },
    "icon": { "$value": { "value": 18, "unit": "px" } },
    "iconSmall": { "$value": { "value": 14, "unit": "px" } }
  },
  "zIndex": {
    "$type": "number", "navigation": { "$value": 20 }, "overlay": { "$value": 40 }, "toast": { "$value": 100 }
  },
  "shadow": {
    "$type": "shadow",
    "floating": { "$value": { "color": "#081B3126", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 8, "unit": "px" }, "blur": { "value": 24, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } },
    "dialog": { "$value": { "color": "#00000040", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 24, "unit": "px" }, "blur": { "value": 80, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } }
  },
  "duration": {
    "$type": "duration", "fast": { "$value": { "value": 160, "unit": "ms" } }, "normal": { "$value": { "value": 200, "unit": "ms" } }
  },
  "ease": { "$type": "cubicBezier", "standard": { "$value": [0.2, 0, 0, 1] } },
  "theme": {
    "light": {
      "bg": "{color.pale}", "surface": "{color.white}", "surfaceRaised": "{color.white}",
      "text": "{color.ink}", "muted": "{color.slate}", "border": "{color.line}",
      "action": "{color.ink}", "actionText": "{color.white}", "focus": "{color.focus}",
      "selected": "{color.infoBg}", "link": "{color.infoText}",
      "infoText": "{color.infoText}", "infoBg": "{color.infoBg}",
      "successText": "{color.successText}", "successBg": "{color.successBg}",
      "warningText": "{color.warningText}", "warningBg": "{color.warningBg}",
      "dangerText": "{color.dangerText}", "dangerBg": "{color.dangerBg}"
    },
    "dark": {
      "bg": "{color.ink}", "surface": "{color.darkSurface}", "surfaceRaised": "{color.darkRaised}",
      "text": "{color.pale}", "muted": "{color.darkMuted}", "border": "{color.darkLine}",
      "action": "{color.mint}", "actionText": "{color.ink}", "focus": "{color.cyan}",
      "selected": "#123B52", "link": "#7DDBFF",
      "infoText": "#7DDBFF", "infoBg": "#123B52", "successText": "#7AE9C5", "successBg": "#10372F",
      "warningText": "#FFD58A", "warningBg": "#3D2D12", "dangerText": "#FFB4B7", "dangerBg": "#3F202C"
    }
  }
}
